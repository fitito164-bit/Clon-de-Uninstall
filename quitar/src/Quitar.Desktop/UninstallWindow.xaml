<Window x:Class="Quitar.Desktop.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Quitar.Desktop"
        Title="{Binding Title}"
        Width="960" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Status}"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,8" />

        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Height="6"
                     Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <ListView x:Name="LeftoversList"
                  Grid.Row="2"
                  ItemsSource="{Binding Rows}"
                  Visibility="{Binding ShowLeftovers, Converter={StaticResource BoolToVisibility}}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="34">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          IsEnabled="{Binding IsEditable}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{x:Static local:Strings.ColKind}" DisplayMemberBinding="{Binding KindText}" Width="120" />
                    <GridViewColumn Header="{x:Static local:Strings.ColRisk}" DisplayMemberBinding="{Binding RiskText}" Width="60" />
                    <GridViewColumn Header="{x:Static local:Strings.ColPath}" DisplayMemberBinding="{Binding Path}" Width="330" />
                    <GridViewColumn Header="{x:Static local:Strings.ColReason}" DisplayMemberBinding="{Binding Reason}" Width="240" />
                    <GridViewColumn Header="{x:Static local:Strings.ColResult}" DisplayMemberBinding="{Binding ResultText}" Width="200" />
                </GridView>
            </ListView.View>
        </ListView>

        <TextBox Grid.Row="3"
                 Margin="0,8,0,0"
                 Text="{Binding LogText, Mode=OneWay}"
                 IsReadOnly="True"
                 FontFamily="Consolas"
                 FontSize="12"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Visibility="{Binding ShowLog, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="{x:Static local:Strings.StopWaiting}"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    Click="StopWaiting_Click"
                    Visibility="{Binding CanStopWaiting, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{x:Static local:Strings.DeleteSelected}"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    Click="Delete_Click"
                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="{x:Static local:Strings.Close}"
                    Padding="14,6"
                    IsCancel="True"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
