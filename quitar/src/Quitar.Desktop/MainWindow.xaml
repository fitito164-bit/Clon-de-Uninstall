<Window x:Class="Quitar.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Quitar.Desktop"
        Title="{x:Static local:Strings.AppTitle}"
        Width="1040" Height="660" MinWidth="720" MinHeight="420"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput">

    <DockPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>

        <Grid DockPanel.Dock="Top" Margin="12,12,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <TextBox x:Name="SearchBox"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{x:Static local:Strings.SearchPlaceholder}"
                           IsHitTestVisible="False"
                           Foreground="Gray"
                           VerticalAlignment="Center"
                           Margin="11,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="14,6"
                    Content="{x:Static local:Strings.Refresh}"
                    Command="{Binding RefreshCommand}" />

            <Button x:Name="UninstallButton"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Padding="14,6"
                    IsEnabled="False"
                    Content="{x:Static local:Strings.Uninstall}"
                    Click="Uninstall_Click" />

            <Button Grid.Column="3"
                    Margin="8,0,0,0"
                    Padding="14,6"
                    Content="{x:Static local:Strings.History}"
                    Click="History_Click" />
        </Grid>

        <ListBox DockPanel.Dock="Top"
                 Margin="12,0,12,6"
                 ItemsSource="{Binding Tabs}"
                 SelectedItem="{Binding SelectedTab}"
                 BorderThickness="0"
                 Background="Transparent">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" Margin="10,4" FontSize="14" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DataGrid x:Name="ProgramsGrid"
                  Margin="12,0,12,12"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserResizeRows="False"
                  EnableRowVirtualization="True"
                  AlternationCount="2"
                  SelectionChanged="ProgramsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static local:Strings.ColName}" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="{x:Static local:Strings.ColPublisher}" Binding="{Binding Publisher}" Width="1.4*" />
                <DataGridTextColumn Header="{x:Static local:Strings.ColVersion}" Binding="{Binding Version}" Width="110" />
                <DataGridTextColumn Header="{x:Static local:Strings.ColDate}" Binding="{Binding InstallDateText}" SortMemberPath="InstallDate" Width="100" />
                <DataGridTextColumn Header="{x:Static local:Strings.ColSize}" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="90" />
                <DataGridTextColumn Header="{x:Static local:Strings.ColArch}" Binding="{Binding ArchText}" Width="70" />
                <DataGridTextColumn Header="{x:Static local:Strings.ColScope}" Binding="{Binding ScopeText}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
