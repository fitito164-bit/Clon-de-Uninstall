<Window x:Class="Quitar.Desktop.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Quitar.Desktop"
        Title="{x:Static local:Strings.HistoryTitle}"
        Width="900" Height="600" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView x:Name="RunsList"
                  Grid.Row="0"
                  SelectionMode="Single"
                  SelectionChanged="RunsList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{x:Static local:Strings.ColWhen}" DisplayMemberBinding="{Binding WhenText}" Width="150" />
                    <GridViewColumn Header="{x:Static local:Strings.ColProgram}" DisplayMemberBinding="{Binding ProgramText}" Width="300" />
                    <GridViewColumn Header="{x:Static local:Strings.ColStatus}" DisplayMemberBinding="{Binding StatusText}" Width="110" />
                    <GridViewColumn Header="{x:Static local:Strings.ColBackups}" DisplayMemberBinding="{Binding BackupsText}" Width="110" />
                    <GridViewColumn Header="{x:Static local:Strings.ColReason}" DisplayMemberBinding="{Binding NoteText}" Width="400" />
                </GridView>
            </ListView.View>
        </ListView>

        <TextBox x:Name="LogBox"
                 Grid.Row="1"
                 Margin="0,8,0,0"
                 IsReadOnly="True"
                 FontFamily="Consolas"
                 FontSize="12"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="RestoreButton"
                    Content="{x:Static local:Strings.RestoreRegistry}"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="Restore_Click" />
            <Button Content="{x:Static local:Strings.Close}"
                    Padding="14,6"
                    IsCancel="True"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
